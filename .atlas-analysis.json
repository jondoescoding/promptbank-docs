  "keyFeatures": [
    "Create and manage reusable AI prompts (text, image, video types)",
    "Organize prompts into shareable vaults with configurable visibility (private, unlisted, public)",
    "Queue AI image and video generations via fal.ai model endpoints",
    "Fork vaults to copy and remix community prompt collections",
    "Pin, move, and organize prompts within vaults",
    "Upload reference images for use in prompt records and generation requests",
    "Cursor-based pagination for scalable prompt and vault listing",
    "Bearer token API key authentication with scoped permissions"
  ],
  "publicApiSurface": [
