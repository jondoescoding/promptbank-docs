{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Prompt Bank",
  "theme": "luma",
  "appearance": {
    "default": "dark"
  },
  "colors": {
    "primary": "#ffff00",
    "light": "#767600",
    "dark": "#ffff00"
  },
  "favicon": "/favicon.svg",
  "background": {
    "color": {
      "light": "#fafafa",
      "dark": "#0d0d0d"
    }
  },
  "fonts": {
    "body": {
      "family": "Geist",
      "source": "/fonts/Geist-variable.woff2",
      "format": "woff2",
      "weight": 400
    },
    "heading": {
      "family": "Geist",
      "source": "/fonts/Geist-variable.woff2",
      "format": "woff2",
      "weight": 500
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Go to Prompt Bank",
      "href": "https://www.promptbank.club"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/prompts",
              "concepts/vaults",
              "concepts/generations"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/manage-prompts",
              "guides/organize-vaults",
              "guides/generate-media",
              "guides/upload-images"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview",
              "api-reference/authentication",
              "api-reference/errors"
            ]
          },
          {
            "group": "Prompts",
            "pages": [
              "api-reference/prompts/list",
              "api-reference/prompts/create",
              "api-reference/prompts/get",
              "api-reference/prompts/update",
              "api-reference/prompts/delete",
              "api-reference/prompts/save-to-vault"
            ]
          },
          {
            "group": "Vaults",
            "pages": [
              "api-reference/vaults/list",
              "api-reference/vaults/create",
              "api-reference/vaults/get",
              "api-reference/vaults/update",
              "api-reference/vaults/delete",
              "api-reference/vaults/fork",
              "api-reference/vaults/list-prompts",
              "api-reference/vaults/add-prompts",
              "api-reference/vaults/remove-prompt",
              "api-reference/vaults/move-prompt",
              "api-reference/vaults/pin-prompt"
            ]
          },
          {
            "group": "Generations",
            "pages": [
              "api-reference/generations/queue"
            ]
          },
          {
            "group": "Uploads",
            "pages": [
              "api-reference/uploads/images"
            ]
          },
          {
            "group": "API keys",
            "pages": [
              "api-reference/api-keys/list",
              "api-reference/api-keys/create",
              "api-reference/api-keys/reveal",
              "api-reference/api-keys/revoke"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "https://www.promptbank.club/brand/promptbank-mark-black-transparent.png",
    "dark": "https://www.promptbank.club/brand/promptbank-mark-white-transparent.png"
  }
}
